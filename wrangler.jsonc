{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // DISABLED: workers.dev URL and Preview URLs are turned off so the Worker
  // can't be invoked over HTTP. To re-enable, set both back to true.
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },

  // DISABLED: cron removed so the Worker never runs on a schedule.
  // To re-enable, restore: "crons": ["0 * * * *"]
  // (Fires hourly; the Worker itself decides, in Europe/Prague local time,
  // whether it's within the Mon-Fri run window -- DST-safe.)
  "triggers": {
    "crons": []
  },

  // Stores the last-published PV per ticker so we can suppress noisy
  // re-alerts when nothing meaningfully changed -- see src/state.ts.
  "kv_namespaces": [
    {
      "binding": "SENTINEL_STATE",
      "id": "f4fb65b2250e4a6c822f3ca2c9dc5252"
    }
  ]

  // Runtime secrets (never put real values here -- set via `wrangler secret put`):
  //   GOOGLE_SERVICE_ACCOUNT_JSON
  //   TELEGRAM_BOT_TOKEN
  //   TELEGRAM_CHAT_ID
  //   RUN_SECRET -- required to authenticate requests to the manual /run route
}
